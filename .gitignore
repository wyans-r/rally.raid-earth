# Secrets and local env (never commit these)
.env
.env.local
.env.*.local
*.pem

# Cloudflare / wrangler local state (may hold auth or local D1/R2)
.wrangler/
**/wrangler.toml.bak

# Dependencies and build output
node_modules/
dist/
__pycache__/
*.pyc
.pytest_cache/

# Editor and OS junk
.DS_Store
Thumbs.db
*.swp

# Local backups and working copies (not source)
*.bak
*.bak-*
*.bak-trackfix
b19-backup/
TRACKFIX_PROGRESS.md
B19_PROGRESS.md
DEPLOY_STATUS.txt
RELEASE_PROGRESS.md

# Large generated archives and ad-hoc screenshots in the old working tree
*.zip
!mod/**/*
stage-builder/download/
tests/browser/screens/

# Official FIM / FIA regulation PDFs, page scans and text extracts are not redistributed here
docs/fim-symbols/*.pdf
docs/fim-symbols/pages/
docs/fim-symbols/*.txt

# Generated by deploy/stagebuilder/deploy.sh; do not commit
deploy/stagebuilder/site/

# Bundled Overpass extracts are generated data (~6 MB); rebuild with stage-builder/scripts/build-overpass-extracts.js
stage-builder/overpass-extracts/*.gz
stage-builder/overpass-extracts/index.json
tools/.cache/
rallies/build/

# Local Python env for the Lua tests (lupa)
.venv/
# Browser test screenshots
tests/browser/screens/
tests/browser/bridge_test.png
