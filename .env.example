# Copy this file to .env and fill in values locally. Never commit .env.
# Tokens and keys go in the environment (or `wrangler secret put` for the
# unreleased Events worker). Do not paste them into chat, issues or source files.

# Required to deploy the public stage builder (wrangler / Cloudflare API).
# Create a token in the Cloudflare dashboard and put it here, or export it
# in your shell. It is already set as CLOUDFLARE_API_TOKEN on the machine
# that currently deploys this site.
CLOUDFLARE_API_TOKEN=

# Cloudflare account id for this project (this is an identifier, not a token).
CLOUDFLARE_ACCOUNT_ID=12d9d7f42a5a938f3f8aa5232a4557fb

# Optional / future (unreleased Events worker). Leave blank until needed.
# Put the real values only in .env or with: wrangler secret put NAME
# NEXTGIS_API_KEY=
# RESEND_API_KEY=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# SESSION_SECRET=
